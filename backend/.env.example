# --- Server ---
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Auth ---
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=11

# --- MongoDB (Prisma) ---
# Atlas: copy your SRV connection string and append a database name (e.g., /ledger)
# Example: mongodb+srv://<user>:<password>@cluster.xxxxx.mongodb.net/ledger?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ledger?retryWrites=true&w=majority

# --- RAG ---
RAG_SERVICE_URL=http://127.0.0.1:8000

# --- Agentic redemption assistant (POST /api/agent/chat) ---
# Without GROQ_API_KEY the assistant still works: a deterministic workflow
# chooses the tools and a template writes the answer.
GROQ_API_KEY=your_groq_api_key_here
# Must be a Groq model with tool calling. List yours: GET https://api.groq.com/openai/v1/models
AGENT_LLM_MODEL=openai/gpt-oss-120b
AGENT_REASONING_EFFORT=low
AGENT_MAX_LLM_TURNS=4
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_WORKFLOW_TOOL_CALLS=4
AGENT_LLM_TIMEOUT_MS=15000
AGENT_TOOL_TIMEOUT_MS=6000
AGENT_TOTAL_TIMEOUT_MS=45000
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_HISTORY_TURNS=6
AGENT_RATE_LIMIT_PER_MIN=12
# Optional JSON override of scoring weights per preset (each preset is renormalised to sum to 1):
# AGENT_SCORING_WEIGHTS={"balanced":{"value":0.4,"cash":0.2,"points":0.2,"preference":0.1,"reliability":0.1}}
